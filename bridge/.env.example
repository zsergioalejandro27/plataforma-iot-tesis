# Copia este archivo como ".env" (sin ".example") y completa los valores.
# El archivo ".env" real NUNCA se sube a GitHub (está en .gitignore).

# HiveMQ Cloud: Cluster -> pestaña "Overview" / "Web Client" y "Access Management"
HIVEMQ_HOST=tu-cluster.s1.eu.hivemq.cloud
HIVEMQ_PORT=8883
HIVEMQ_USER=usuario-del-bridge
HIVEMQ_PASSWORD=

# Supabase: Project Settings -> API
SUPABASE_URL=https://tu-proyecto.supabase.co
# Llave "service_role" (secreta, se salta RLS). Solo en el servidor del bridge.
SUPABASE_SERVICE_KEY=
