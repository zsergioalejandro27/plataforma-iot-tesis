# Copia este archivo como ".env" (sin ".example") y completa los valores.
# El archivo ".env" real NUNCA se sube a GitHub (está en .gitignore).

# HiveMQ Cloud (los usan publish_test.py y auto_publisher.py)
HIVEMQ_HOST=tu-cluster.s1.eu.hivemq.cloud
HIVEMQ_PORT=8883
HIVEMQ_USER=usuario-del-simulador
HIVEMQ_PASSWORD=

# Supabase (solo auto_publisher.py, para leer la lista de dispositivos)
SUPABASE_URL=https://tu-proyecto.supabase.co
# Llave "service_role" (secreta, se salta RLS). Solo en el servidor.
SUPABASE_SERVICE_KEY=

# Cada cuántos segundos publica una ronda auto_publisher.py (por defecto 300)
PUBLISH_INTERVAL_SECONDS=300
